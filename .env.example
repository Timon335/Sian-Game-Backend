# คัดลอกเป็น .env แล้วใส่ค่าจริงในเครื่องเท่านั้น ห้าม commit ไฟล์ .env
# Supabase: ใช้ Session pooler พอร์ต 5432 และต่อท้าย ?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# สุ่มค่าที่ยาวอย่างน้อย 32 ตัวอักษร
JWT_SECRET=
# ใส่ได้หลาย origin คั่นด้วยจุลภาค
ALLOWED_ORIGINS=http://localhost:3000
# เทสต์ฐานข้อมูล: ใช้ PostgreSQL ในเครื่องเท่านั้น ห้ามชี้ Supabase
# TEST_DATABASE_URL=postgres://postgres@localhost:55432/siangame_test?sslmode=disable
